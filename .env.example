# ===========================================================================
# Copy this file to .env  (cp .env.example .env) and edit the values.
# .env is listed in .gitignore -- never commit real credentials.
# ===========================================================================

# ---- MySQL / MariaDB ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=scm_app
DB_PASSWORD=change-me
DB_NAME=supplychain
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=8

# ---- Flask ----------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0
SECRET_KEY=change-me-too
APP_ENV=development

# ---- analysis parameters (documented in docs/04_analysis_methodology.md) --
WINDOW_DAYS=90                 # rolling demand window in calendar days
SERVICE_LEVEL=0.95             # target cycle service level -> z factor
SAFETY_STOCK_DAYS=7            # alternative safety-stock policy (days of demand)
SAFETY_STOCK_POLICY=max        # zscore | days | max
REVIEW_PERIOD_DAYS=7           # order-up-to level = ROP + mu*review_period
EXCESS_COVER_DAYS=90           # days of cover above which stock is "excess"
STOCKOUT_POSITION_RATIO=1.0    # kept for reference in the risk rules
FORECAST_HORIZON_DAYS=28       # forward forecast length
FORECAST_HOLDOUT_DAYS=28       # hold-out period used to score models
FORECAST_BASELINE_WINDOW=28    # naive baseline = mean of last N days
SUPPLIER_WINDOW_DAYS=365       # trailing PO window for supplier KPIs
TARGET_ON_TIME_RATE=0.90
TARGET_LEAD_TIME_VARIANCE=3.0

# ---- output ---------------------------------------------------------------
REPORT_DIR=reports
TIMEZONE=Asia/Kolkata
